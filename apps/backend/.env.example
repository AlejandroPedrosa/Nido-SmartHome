# ============================================================
# NIDO SmartHome — Variables de entorno del backend
# Copiar este archivo como .env y completar los valores.
# Nunca commitear el archivo .env (contiene credenciales).
# Ver apps/backend/README.md → "Variables de entorno".
# ============================================================

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Supabase → botón "Connect" → Session pooler (puerto 5432)
# No agregar ?sslmode=... a la URL: el SSL se configura desde la API.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Certificado raíz de Supabase para verificar el servidor (SSL).
# Supabase → Project Settings → Database → SSL Configuration → Download certificate
DATABASE_SSL_CA_PATH=certs/supabase-ca.crt

# Supabase → Project Settings → Data API (Project URL, sin /rest/v1)
#            y API Keys (Publishable key, sb_publishable_...)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Origen(es) del frontend permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# (Opcional) URL base del frontend para los links de los emails de Supabase
# (confirmación de cuenta). Si falta, se usa el primer origen de CORS_ORIGIN.
# Debe figurar en Supabase → Authentication → URL Configuration → Redirect URLs.
# FRONTEND_URL=http://localhost:5173
